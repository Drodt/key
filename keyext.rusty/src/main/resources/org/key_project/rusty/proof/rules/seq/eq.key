\rules(sequences:on) {
    // --------------------------------------------------------------------------
    // equality handling (derived rules)
    // --------------------------------------------------------------------------

    eqSeqEmpty {
        \schemaVar \term Seq<E> s;

        \find(s = seqEmpty<E>)
        \replacewith(seqLen<E>(s) = 0)
    };

    eqSeqSingleton {
        \schemaVar \term Seq<E> s;
        \schemaVar \term E x;

        \find(s = seqSingleton<E>(x))
        \replacewith(seqLen<E>(s) = 1 & seqGet<E>(s, 0) = x)
    };

    eqSeqSingleton2 {
        \schemaVar \term Seq<E> s, s2;
        \schemaVar \term E x;

        \assumes(seqSingleton<E>(x) = s2 ==>)
        \find(s = s2)
        \replacewith(seqLen<E>(s) = 1 & seqGet<E>(s, 0) = x)
    };

    eqSeqConcat {
        \schemaVar \term Seq<E> s, s1, s2;

        \find(s = seqConcat<E>(s1, s2))

        \replacewith(
            seqLen<E>(s) = seqLen<E>(s1) + seqLen<E>(s2)
            & seqSub<E>(s, 0, seqLen<E>(s1)) = s1
            & seqSub<E>(s, seqLen<E>(s1), seqLen<E>(s)) = s2
        )
    };

    eqSeqConcat2 {
        \schemaVar \term Seq<E> s, s1, s2;

        \find(seqConcat<E>(s, s1) = seqConcat<E>(s, s2))

        \replacewith(s1 = s2)
        \heuristics(seqSimplify)
        \generate(\EQ(seqConcat<E>(s, s2) : no_self_application, seqSimplify))
    };

    eqSeqConcat3 {
        \schemaVar \term Seq<E> s, s1, s2;

        \find(seqConcat<E>(s1, s) = seqConcat<E>(s2, s))

        \replacewith(s1 = s2)
        \heuristics(seqSimplify)
        \generate(\EQ(seqConcat<E>(s2, s) : no_self_application, seqSimplify))
    };

    eqSeqConcat4 {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \term E x, y;

        \find(seqConcat<E>(s1, seqSingleton<E>(x)) = seqConcat<E>(s2, seqSingleton<E>(y)))

        \replacewith(s1 = s2 & x = y)
        \heuristics(seqSimplify)
    };

    eqSeqConcat4EQ {
        \schemaVar \term Seq<E> s1, s2, EQ;
        \schemaVar \term E x, y;

        \assumes(seqConcat<E>(s2, seqSingleton<E>(x)) = EQ ==>)
        \find(seqConcat<E>(s1, seqSingleton<E>(y)) = EQ)

        \replacewith(s1 = s2 & x = y)
        \heuristics(no_self_application, seqSimplify)
    };

    eqSeqConcat5 {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \term E x, y;

        \find(seqConcat<E>(seqSingleton<E>(x), s1) = seqConcat<E>(seqSingleton<E>(y), s2))

        \replacewith(x = y & s1 = s2)
        \heuristics(seqSimplify)
    };

    eqSeqConcat5EQ {
        \schemaVar \term Seq<E> s1, s2, EQ;
        \schemaVar \term E x, y;

        \assumes(seqConcat<E>(seqSingleton<E>(x), s2) = EQ ==>)
        \find(seqConcat<E>(seqSingleton<E>(y), s1) = EQ)

        \replacewith(x = y & s1 = s2)
        \heuristics(no_self_application, seqSimplify)
    };

    eqSeqReverse {
        \schemaVar \term Seq<E> s, s2;
        \schemaVar \variables int iv;

        \find(s = seqReverse<E>(s2))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(s2))

        \replacewith(
            seqLen<E>(s) = seqLen<E>(seqReverse<E>(s2))
            & \forall iv; (0 <= iv & iv < seqLen<E>(s)
                -> seqGet<E>(s, iv) = seqGet<E>(seqReverse<E>(s2), iv)
            )
        )
    };

    eqSeqReverse2 {
        \schemaVar \term Seq<E> s, s2, t;
        \schemaVar \variables int iv;

        \assumes(seqReverse<E>(s2) = t ==>)
        \find(s = t)
        \varcond(\noFreeVarIn(s), \noFreeVarIn(s2), \noFreeVarIn(t))

        \replacewith(
            seqLen<E>(s) = seqLen<E>(seqReverse<E>(s2))
            & \forall iv; (0 <= iv & iv < seqLen<E>(s)
                -> seqGet<E>(s, iv) = seqGet<E>(seqReverse<E>(s2), iv)
            )
        )
    };

    eqSeqDef {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int l, u;
        \schemaVar \term E a;
        \schemaVar \variables int i, iv;

        \find(s = seqDef<E>{i;}(l, u, a))
        \varcond(
            \noFreeVarIn(s),
            \noFreeVarIn(l),
            \noFreeVarIn(u),
            \noFreeVarIn(a), \noFreeVarIn(a))

        \replacewith(
            seqLen<E>(s) = seqLen<E>(seqDef<E>{i;}(l, u, a))
            & \forall iv; (0 <= iv & iv < seqLen<E>(s)
                -> seqGet<E>(s, iv) = seqGet<E>(seqDef<E>{i;}(l, u, a), iv)
            )
        )
    };

    eqSeqDef2 {
        \schemaVar \term Seq<E> s, t;
        \schemaVar \term int l, u;
        \schemaVar \term E a;
        \schemaVar \variables int i, iv;

        \assumes(seqDef<E>{i;}(l, u, a) = t ==>)
        \find(s = t)
        \varcond(
            \noFreeVarIn(s),
            \noFreeVarIn(l),
            \noFreeVarIn(u),
            \noFreeVarIn(a), \noFreeVarIn(a),
            \noFreeVarIn(t))

        \replacewith(
            seqLen<E>(s) = seqLen<E>(seqDef<E>{i;}(l, u, a))
            & \forall iv; (0 <= iv & iv < seqLen<E>(s)
                -> seqGet<E>(s, iv) = seqGet<E>(seqDef<E>{i;}(l, u, a), iv)
            )
        )
    };

    \lemma
    eqSameSeq {
        \schemaVar \term Seq<E> seq;
        \schemaVar \term int from, to;
        \schemaVar \variables int iv;

        \find(seqSub<E>(seq, from, to) = seq)
        \varcond(\noFreeVarIn(from), \noFreeVarIn(seq))

        \replacewith((from = 0 & seqLen<E>(seq) = to)
            | (to <= from & seqLen<E>(seq) = 0)
            | (seqLen<E>(seq) = to - from
                & \forall iv; (
                    0 <= iv & iv < seqLen<E>(seq)
                    -> seqGet<E>(seq, iv) = seqGet<E>(seq, iv + from)))
        )
    };
}
