\sorts {
    SRef<[S]>;
    MRef<[S]>;
    Place<[S]>;
}

\functions {
    refS<[S]>(S) -> SRef<[S]>;
    refM<[S]>(Place<[S]>) -> MRef<[S]>;
    derefS<[S]>(SRef<[S]>) -> S;
    \nonRigid derefM<[M]>(MRef<[M]>) -> M;
    arrPlace<[M, const N: int]>(MRef<[Array<[M, const N]>]>, int) -> Place<[M]>;
}
