/*
 * Casts in the logic.
 *
 * A parametric cast function `cast<[E]>(any) -> E` reinterprets a value of any
 * sort as the type parameter `E` (the counterpart of the parametric `ghost<[E]>`
 * / `read<[E]>` functions). It is meant to be inserted by the taclet-application
 * logic (RewriteTacletExecutor) so that a replacewith result of the top sort
 * `any` is given the concrete sort required by its position.
 *
 * The taclets are adapted from the cast family of legacy KeY's genericRules.key
 * (castDel, nested-cast collapse). They are deliberately conservative.
 */

\sorts {
    \generic alpha;
    \generic beta;
}

\functions {
    cast<[E]>(any) -> E;
}

\schemaVariables {
    \term any   castArg;
    \term alpha castAlphaArg;
}

\rules {
    // genericRules.key: castDel
    // A cast to a sort the argument already has is the identity. `castAlphaArg : alpha` only
    // matches an argument whose sort already fits `alpha`, so a genuine narrowing cast is not removed.
    castDel {
        \find(cast<[alpha]>(castAlphaArg))
        \replacewith(castAlphaArg)
        \heuristics(simplify, cast_deletion)
    };
}
