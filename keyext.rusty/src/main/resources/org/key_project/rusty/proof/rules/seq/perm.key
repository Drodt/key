// This file contains the rule set for permutations in
// the sequence data type
// author P.H. Schmitt


// This file contains RULES for the permutation predicates in
// the sequence datatype.

// Find the DECLARATIONS in file seq.key and
// definitional extensions in file seqRules.key

\sorts {
    \generic E;
}

\rules(sequences:on) {
    // --------------------------------------------------------------------------
    //  Second Extensions by Definitions
    //  These taclets were not part of the original Seq<E> axiomatization by
    //  B.Weiss
    //  These taclets extend the signature of the core theory by introducing
    //  the relation symbols
    //            seqPerm(Seq,Seq), seqNPerm(Seq)
    //  and the function symbols
    //           Seq<E> seqSwap(Seq,int,int)
    //           Seq<E> seqRemove(Seq,int)
    //  by direct definitions.
    //  Consistency of the extended theory is thus guaranteed.
    //  (Theorem on  conservative extensions)
    // --------------------------------------------------------------------------

    seqNPermDefReplace {
        \schemaVar \term Seq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(seqNPerm(s1))
        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s1))

        \replacewith(
            (\forall iv; (0 <= iv & iv < seqLen<int>(s1) ->
                    \exists jv; (0 <= jv & jv < seqLen<int>(s1) & seqGet<int>(s1, jv) = iv))))
    };

    seqNPermDefLeft {
        \schemaVar \term Seq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(seqNPerm(s1) ==>)
        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s1))

        \add(
            (\forall iv; (0 <= iv & iv < seqLen<int>(s1) ->
                    \exists jv; (0 <= jv & jv < seqLen<int>(s1) & seqGet<int>(s1, jv) = iv))) ==>)
    };

    seqPermDefLeft {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables Seq<int> s;

        \find(seqPerm<E>(s1, s2) ==>)

        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s2),
            \noFreeVarIn(s1), \noFreeVarIn(s2))

        \add(
            seqLen<E>(s1) = seqLen<E>(s2) &
            (\exists s; (seqLen<int>(s) = seqLen<E>(s1) & seqNPerm(s) &

                    (\forall iv; (0 <= iv & iv < seqLen<int>(s) ->
                            seqGet<E>(s1, iv) = seqGet<E>(s2, seqGet<int>(s, iv))))))
            ==>)
    };

    seqPermDef {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables Seq<int> s;

        \find(seqPerm<E>(s1, s2))

        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s2),
                    \noFreeVarIn(s1), \noFreeVarIn(s2))

        \replacewith(
            seqLen<E>(s1) = seqLen<E>(s2) &
            (\exists s; (seqLen<int>(s) = seqLen<E>(s1) & seqNPerm(s) &

                    (\forall iv; (0 <= iv & iv < seqLen<int>(s) ->
                            seqGet<E>(s1, iv) = seqGet<E>(s2, seqGet<int>(s, iv))))))
        )
    };

    defOfSeqSwap {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int iv, jv;
        \schemaVar \variables int uSub;

        \find(seqSwap<E>(s, iv, jv))

        \varcond(\noFreeVarIn(s),
            \noFreeVarIn(iv),
            \noFreeVarIn(jv))
        \replacewith(seqDef<E>{uSub;}(0, seqLen<E>(s),
                \if(!(0 <= iv & 0 <= jv & iv < seqLen<E>(s) & jv < seqLen<E>(s)))
                    \then(seqGet<E>(s, uSub))
                    \else(\if(uSub = iv)
                            \then(seqGet<E>(s, jv))
                            \else(\if(uSub = jv)
                                    \then(seqGet<E>(s, iv))
                                    \else(seqGet<E>(s, uSub))))))

    };

    defOfSeqRemove {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int iv;
        \schemaVar \variables int uSub;

        \find(seqRemove<E>(s, iv))
        \varcond(\noFreeVarIn(s),
            \noFreeVarIn(iv))

        \replacewith(
            \if(iv < 0 | seqLen<E>(s) <= iv)
                \then(s)
                \else(seqDef<E>{uSub;}(0, seqLen<E>(s) - 1,
                        \if(uSub < iv)
                            \then(seqGet<E>(s, uSub))
                            \else(seqGet<E>(s, uSub + 1)))))
    };

    // --------------------------------------------------------------------
    // definition for seqNPermInv
    //
    // --------------------------------------------------------------------

    defOfSeqNPermInv {
        \schemaVar \term Seq<int> s;
        \schemaVar \variables int uSub;

        \find(seqNPermInv(s))
        \varcond(\noFreeVarIn(s))

        \replacewith(seqDef<int>{uSub;}(0, seqLen<int>(s), seqIndexOf<int>(s, uSub)))
    };

    // ==================================================================
    //  derived taclets involving the functions seqSwap, seqRemove,
    //  and seqNPermInv
    //
    // ==================================================================

    seqLenOfNPermInv {
        \schemaVar \term Seq<int> s1;
        \find(seqLen<int>(seqNPermInv(s1)))
        \replacewith(seqLen<int>(s1))

        \heuristics(seqSimplify)
        \generate(\EQ(seqNPermInv(s1)))
    };

    seqGetOfNPermInv {
        \schemaVar \term Seq<int> s1;
        \schemaVar \term int i3;
        \schemaVar \skolemTerm int jsk;

        \find(seqGet<int>(seqNPermInv(s1), i3))
        \varcond(\newDependingOn(jsk, i3))
        \replacewith(jsk)
        \add(seqGet<int>(s1, jsk) = i3 & 0 <= jsk & jsk < seqLen<int>(s1) ==>);
        \add( ==> 0 <= i3 & i3 < seqLen<int>(s1) & seqNPerm(s1))

        \heuristics(seqSimplify)
        \generate(\EQ(seqNPermInv(s1) : no_self_application, seqSimplify))
    };

    seqLenOfSwap {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int iv1, iv2;
        \find(seqLen<E>(seqSwap<E>(s1, iv1, iv2)))
        \replacewith(seqLen<E>(s1))

        \heuristics(seqSimplify)
        \generate(\EQ(seqSwap<E>(s1, iv1, iv2)))
    };

    seqLenOfRemove {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int iv1;

        \find(seqLen<E>(seqRemove<E>(s1, iv1)))
        \replacewith(
            \if(0 <= iv1 & iv1 < seqLen<E>(s1))
                \then(seqLen<E>(s1) - 1)
                \else(seqLen<E>(s1)))

        \heuristics(seqSimplifyEnlarging)
        \generate(\EQ(seqRemove<E>(s1, iv1)))
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    seqGetOfRemoveAny {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int i3, i2;

        \find(seqGet<E>(seqRemove<E>(s1, i2), i3))
        \replacewith(\if(i2 < 0 | seqLen<E>(s1) <= i2)
                \then(seqGet<E>(s1, i3))
                \else(\if(i3 < i2)
                        \then(seqGet<E>(s1, i3))
                        \else(\if(i2 <= i3 & i3 < seqLen<E>(s1) - 1)
                                \then(seqGet<E>(s1, i3 + 1))
                                \else(seqGetOutside<E>))))

        \heuristics(seqRead)
        \generate(\EQ(seqRemove<E>(s1, i2) : no_self_application, seqSimplifyEnlarging))
    };

    seqGetOfRemoveInt {
        \schemaVar \term Seq<int> s1;
        \schemaVar \term int i3, i2;

        \find(seqGet<int>(seqRemove<int>(s1, i2), i3))
        \replacewith(\if(i2 < 0 | seqLen<int>(s1) <= i2)
                \then(seqGet<int>(s1, i3))
                \else(\if(i3 < i2)
                        \then(seqGet<int>(s1, i3))
                        \else(\if(i2 <= i3 & i3 < seqLen<int>(s1) - 1)
                                \then(seqGet<int>(s1, i3 + 1))
                                \else(seqGetOutside<int>))))

        \heuristics(seqRead)
        \generate(\EQ(seqRemove<int>(s1, i2) : no_self_application, seqSimplifyEnlarging))
    };

    seqLenOfRemoveConcrete1 {
        \schemaVar \term Seq<E> s1;

        \assumes(seqLen<E>(s1) >= 1 ==>)
        \find(seqLen<E>(seqRemove<E>(s1, seqLen<E>(s1) - 1)))
        \replacewith(seqLen<E>(s1) - 1)

        \heuristics(seqSimplify)
    };

    seqLenOfRemoveConcrete2 {
        \schemaVar \term Seq<E> s1;

        \assumes(seqLen<E>(s1) >= 1 ==>)
        \find(seqLen<E>(seqRemove<E>(s1, 0)))
        \replacewith(seqLen<E>(s1) - 1)

        \heuristics(seqSimplify)
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    seqGetOfRemoveAnyConcrete1 {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int i3, i2;
        \assumes(seqLen<E>(s1) >= 1 ==>)
        \find(seqGet<E>(seqRemove<E>(s1, seqLen<E>(s1) - 1), i3))
        \replacewith(\if(i3 < seqLen<E>(s1) - 1)
                \then(seqGet<E>(s1, i3))
                \else(seqGetOutside<E>))

        \heuristics(seqSimplifyEnlarging)
    };

    //  Differs from seqOutsideValue in seqStandard-new-verify.key
    //

    seqGetOfRemoveAnyConcrete2 {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int i3, i2;
        \assumes(seqLen<E>(s1) >= 1 ==>)
        \find(seqGet<E>(seqRemove<E>(s1, 0), i3))
        \replacewith(\if(0 <= i3 & i3 < seqLen<E>(s1) - 1)
                \then(seqGet<E>(s1, i3 + 1))
                \else(seqGetOutside<E>))

        \heuristics(seqSimplifyEnlarging)
    };

    // --------------------------------------------------------------------------
    //  derived basic properties of permutations on natural
    //  numbers
    //
    // --------------------------------------------------------------------------


    //
    //  The following taclet formalizes a kind of pidgeon hole principle
    //  It is the only taclet whose derivation requires induction
    //

    // seqNPermRange {
    //        \schemaVar \term Seq<int> s;
    //        \schemaVar \variables int iv;
    //      \find(seqNPerm(s) ==> )
    //      \varcond( \noFreeVarIn(s)  )
    //      \add(\forall iv;((0 <= iv & iv <  seqLen<int>(s))
    //         ->  (0 <= seqGet<int>(s,iv) &  seqGet<int>(s,iv) < seqLen<int>(s))) ==>)
    //            };
    // Improved version by PHS, correctness proof from Oct.19.2016

    \lemma
    seqNPermRange {
        \schemaVar \term Seq<int> s;
        \schemaVar \variables int iv;
        \find(seqNPerm(s) ==>)
        \varcond(\noFreeVarIn(s))
        \add(\forall iv; ((0 <= iv & iv < seqLen<int>(s))
                -> (0 <= seqGet<int>(s, iv) & seqGet<int>(s, iv) < seqLen<int>(s))) ==>)
    };

    //
    //  The following taclet formalizes the mathematical fact
    //  that every sujective function from a finite set into
    //  itself is injective.
    //  It can be proved using the previous taclet without induction.
    //

    seqNPermInjective {
        \schemaVar \term Seq<int> s;
        \schemaVar \variables int iv, jv;
        \find(seqNPerm(s) ==>)
        \varcond(\noFreeVarIn(s), \noFreeVarIn(s))
        \add(\forall iv; (\forall jv; (
                    (0 <= iv & iv < seqLen<int>(s) & 0 <= jv & jv < seqLen<int>(s)
                        & seqGet<int>(s, iv) = seqGet<int>(s, jv))
                    -> iv = jv)) ==>)

    };

    \lemma
    seqNPermRangeOfGet {
        \schemaVar \term Seq<int> s;
        \schemaVar \term int i;
        \assumes(seqNPerm(s) ==>)
        \find(seqGet<int>(s, i))
        \add((0 <= i & i < seqLen<int>(s))
                -> (0 <= seqGet<int>(s, i) & seqGet<int>(s, i) < seqLen<int>(s)) ==>)
        \heuristics(seqNPermProperties)
    };

    \lemma
    seqNPermInjectiveOnGet {
        \schemaVar \term Seq<int> s;
        \schemaVar \term int i, j;
        \assumes(seqNPerm(s) ==>)
        \find(seqGet<int>(s, i) = seqGet<int>(s, j))
        \add((0 <= i & i < seqLen<int>(s) & 0 <= j & j < seqLen<int>(s)
                & seqGet<int>(s, i) = seqGet<int>(s, j)) -> i = j ==>)
        \heuristics(seqNPermProperties)
    };

    // More transitivity rules (used for automation, see at end)

    \lemma
    seqPermTrans {
        \schemaVar \term Seq<E> s1, s2, s3;

        \assumes(seqPerm<E>(s2, s3) ==>)
        \find(seqPerm<E>(s1, s2) ==>)
        \add(seqPerm<E>(s1, s3) ==>)
    };

    // DB: changed 25/10/2013 to be applied on RHS
    \lemma
    seqPermRefl {
        \schemaVar \term Seq<E> s;
        \find(seqPerm<E>(s, s))
        \replacewith(true)
        \heuristics(seqConcrete)
    };

    seqPermEmpty1 {
        \schemaVar \term Seq<E> s;
        \find(seqPerm<E>(seqEmpty<E>, s))
        \replacewith(seqEmpty<E> = s)
        \heuristics(seqSimplify)
        \displayname "seqPermEmpty"
    };

    seqPermEmpty2 {
        \schemaVar \term Seq<E> s;
        \find(seqPerm<E>(s, seqEmpty<E>))
        \replacewith(seqEmpty<E> = s)
        \heuristics(seqSimplify)
        \displayname "seqPermEmpty"
    };

    seqNPermSwapNPerm {
        \schemaVar \term Seq<int> s1;
        \schemaVar \variables int iv, jv;

        \find(seqNPerm(s1) ==>)
        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s1))

        \add(\forall iv; (\forall jv; (
                    (0 <= iv & 0 <= jv & iv < seqLen<int>(s1) & jv < seqLen<int>(s1))
                    -> seqNPerm(seqSwap<int>(s1, iv, jv)))) ==>)

    };

    // changed; proven in KeY -- DB 29/10/2013
    seqNPermEmpty {
        \find(seqNPerm(seqEmpty<int>))
        \replacewith(true)
        \heuristics(seqConcrete)
    };

    // changed; proven in KeY -- DB 29/10/2013
    seqNPermSingletonConrete {
        \find(seqNPerm(seqSingleton<int>(0)))
        \replacewith(true)
        \heuristics(seqConcrete)
    };

    // changed; proven in KeY -- DB 29/10/2013
    seqNPermSingleton {
        \schemaVar \term int si;
        \find(seqNPerm(seqSingleton<int>(si)))
        \replacewith(si = 0)
        \heuristics(seqSimplify)
    };

    seqNPermComp {
        \schemaVar \term Seq<int> s1, s2;
        \schemaVar \variables int u;
        \assumes(seqNPerm(s2) & seqLen<int>(s1) = seqLen<int>(s2) ==>)
        \find(seqNPerm(s1) ==>)
        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s2))

        \add(seqNPerm(seqDef<int>{u;}(0, seqLen<int>(s1),
                    seqGet<int>(s1, seqGet<int>(s2, u)))) ==>)

    };

    seqGetSInvS {
        \schemaVar \term Seq<int> s;
        \schemaVar \term int t;

        \find(seqGet<int>(s, seqGet<int>(seqNPermInv(s), t)))
        \replacewith(t);
        \add( ==> seqNPerm(s) & 0 <= t & t < seqLen<int>(s))

        // \heuristics(simplify)

    };

    seqNPermInvNPermLeft {
        \schemaVar \term Seq<int> s1;

        \find(seqNPerm(s1) ==>)
        \add(seqNPerm(seqNPermInv(s1)) ==>)
    };

    // DB: changed 25/10/2013 to be applied on RHS
    seqPermSym {
        \schemaVar \term Seq<E> s1, s2;
        \find(seqPerm<E>(s1, s2))
        \replacewith(seqPerm<E>(s2, s1))
    };

    seqNPermInvNPermReplace {
        \schemaVar \term Seq<int> s1;

        \find(seqNPerm(seqNPermInv(s1)))
        \replacewith(seqNPerm(s1))
    };

    seqPermConcatFW {
        \schemaVar \term Seq<E> s1, s2, t1, t2;

        \assumes(seqPerm<E>(s1, t1) ==>)
        \find(seqPerm<E>(s2, t2) ==>)
        \add(seqPerm<E>(seqConcat<E>(s1, s2), seqConcat<E>(t1, t2)) ==>)
    };

    seqPermConcatBW {
        \schemaVar \term Seq<E> s1, s2, t1, t2;

        \assumes(seqPerm<E>(s1, t1) ==>)
        \find( ==> seqPerm<E>(seqConcat<E>(s1, s2), seqConcat<E>(t1, t2)))
        \replacewith( ==> seqPerm<E>(s2, t2))
    };

    \lemma
    seqPermSplit {
        \schemaVar \term Seq<E> s1, s2, t1, t2;
        \find( ==> seqPerm<E>(seqConcat<E>(s1, s2), seqConcat<E>(t1, t2)))
        \replacewith( ==> seqPerm<E>(s1, t1) & seqPerm<E>(s2, t2))
    };

    seqnormalizeDef {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term int le, ri;
        \schemaVar \term E t;
        \schemaVar \variables int u;

        \find(seqDef<E>{u;}(le, ri, t))
        \varcond(\noFreeVarIn(le), \noFreeVarIn(ri))
        \replacewith(\if(le < ri)
                \then(seqDef<E>{u;}(0, (ri - le), ({\subst u; (u + le)}t)))
                \else(seqEmpty<E>))
    };

    \lemma
    seqNPermRight {
        \schemaVar \term Seq<int> s;
        \schemaVar \variables int iv, jv;

        \find( ==> seqNPerm(s))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(s))
        \add( ==> \forall iv; (\forall jv; (
                    (0 <= iv & iv < seqLen<int>(s) & 0 <= jv & jv < seqLen<int>(s)
                        & seqGet<int>(s, iv) = seqGet<int>(s, jv))
                    -> iv = jv))
            & \forall iv; (0 <= iv & iv < seqLen<int>(s) -> 0 <= seqGet<int>(s, iv) & seqGet<int>(s, iv) < seqLen<int>(s)))
    };

    \lemma
    seqPermFromSwap {
        \schemaVar \term Seq<E> s1, s2, t1, t2;
        \schemaVar \variables int iv, jv;

        \assumes(seqPerm<E>(s1, t1) ==>)
        \find( ==> seqPerm<E>(s2, t2))
        \varcond(
            \noFreeVarIn(s1),
            \noFreeVarIn(s2),
            \noFreeVarIn(t1),
            \noFreeVarIn(t2),
            \noFreeVarIn(s1),
            \noFreeVarIn(s2),
            \noFreeVarIn(t1),
            \noFreeVarIn(t2))
        \replacewith( ==> t1 = t2 &
            \exists iv; \exists jv; (0 <= iv & 0 <= jv & iv < s2.length & jv < s2.length &
                s1 = seqSwap<E>(s2, iv, jv)))
    };

    \lemma
    seqSwapPreservesSeqPerm {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int x;
        \schemaVar \term int y;

        \find(==> seqPerm<E>(s, seqSwap<E>(s, x, y)))
        \add( ==> 0 <= x & x < seqLen<E>(s) & 0 <= y & y < seqLen<E>(s))
        \heuristics(seqSimplifyEnlarging)
        \generate(\EQ(seqSwap<E>(s, x, y)))
    };

    /* seqPermOrder {
     \schemaVar \term Seq<E> commEqLeft, commEqRight;
     \find(seqPerm<E>(commEqLeft, commEqRight))
     \replacewith(seqPerm<E>(commEqRight, commEqLeft))
     \heuristics(order_terms)
    };*/

    // These rules are variants of seqPermTrans used to prove transitive
    // seqPerm challenges automatically.

    \lemma
    seqPermTransAlt0 {
        \schemaVar \term Seq<E> s1, s2, s3, x, y;

        \assumes(seqPerm<E>(s2, s3) ==> seqPerm<E>(x, y))
        \find(seqPerm<E>(s1, s2) ==>)
        \add(seqPerm<E>(s1, s3) ==>)
        \displayname "seqPermTrans"
    };

    \lemma
    seqPermTransAlt1 {
        \schemaVar \term Seq<E> a, b, c, x, y;
        \assumes(seqPerm<E>(a, b) ==> seqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(seqPerm<E>(a, c) ==>)
        \add(seqPerm<E>(b, c) ==>)
        \displayname "seqPermTrans"
    };

    \lemma
    seqPermTransAlt2 {
        \schemaVar \term Seq<E> a, b, c, x, y;
        \assumes(seqPerm<E>(a, c) ==> seqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(seqPerm<E>(b, c) ==>)
        \add(seqPerm<E>(a, b) ==>)
        \displayname "seqPermTrans"
    };

    \lemma
    seqPermTransAlt3 {
        \schemaVar \term Seq<E> a, b, c, x, y;
        \assumes(seqPerm<E>(a, c) ==> seqPerm<E>(x, y))
        // apply this rule only if there is a seqPerm goal to prove!
        \find(seqPerm<E>(b, a) ==>)
        \add(seqPerm<E>(b, c) ==>)
        \displayname "seqPermTrans"
    };

    // Proven by ulbrich in Isabelle/HOL
    /*TODO(DD): seqPermCountsInt {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \variables int iv;
        \schemaVar \variables E element;

        \find(seqPerm<E>(s1, s2))

        \varcond(
            \noFreeVarIn(s1, s2),
            \noFreeVarIn(s1, s2)
        )

        \replacewith(
            (\forall element;
                bsum{iv;}(0, s1.length, \if(seqGet<E>(s1, iv) = element) \then(1) \else(0)) =
                bsum{iv;}(0, s2.length, \if(seqGet<E>(s2, iv) = element) \then(1) \else(0))
            )
        )
    };*/

    \lemma
    seqPermForall {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term Seq<E> s2;
        \schemaVar \formula phi;
        \schemaVar \variable int iv;
        \schemaVar \variable E x;
        \assumes(seqPerm<E>(s1, s2) ==>)
        \varcond(\noFreeVarIn(phi), \noFreeVarIn(s1), \noFreeVarIn(s2))
        \add(\forall iv; (0 <= iv & iv < seqLen<E>(s1) -> {\subst x; seqGet<E>(s1, iv)}phi)
            <->
            \forall iv; (0 <= iv & iv < seqLen<E>(s1) -> {\subst x; seqGet<E>(s2, iv)}phi) ==>)
    };

    \lemma
    seqPermExists {
        \schemaVar \term Seq<E> s1;
        \schemaVar \term Seq<E> s2;
        \schemaVar \formula phi;
        \schemaVar \variable int iv;
        \schemaVar \variable E x;
        \assumes(seqPerm<E>(s1, s2) ==>)
        \varcond(\noFreeVarIn(phi), \noFreeVarIn(s1), \noFreeVarIn(s2))
        \add(\exists iv; (0 <= iv & iv < seqLen<E>(s1) & {\subst x; seqGet<E>(s1, iv)}phi)
            <->
            \exists iv; (0 <= iv & iv < seqLen<E>(s1) & {\subst x; seqGet<E>(s2, iv)}phi) ==>)
    };

    /*TODO(DD): seqCountDef {
        \schemaVar \term Seq<E> s;
        \schemaVar \term E e;
        \schemaVar \variables int iv;

        \find(seqCount<E>(s, e))
        \varcond(\noFreeVarIn(s), \noFreeVarIn(e))
        \replacewith(bsum{iv;}(0, seqLen<E>(s), \if (seqGet<E>(s, iv) = e) \then (1) \else (0)))
    };*/

    \lemma
    seqPermCount {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \variables E e;

        \find(seqPerm<E>(s1, s2))
        \varcond(\noFreeVarIn(s1), \noFreeVarIn(s2))
        \replacewith(\forall e; seqCount<E>(s1, e) = seqCount<E>(s2, e))
        \heuristics(seqPermCount)
    };

    \lemma
    seqPermCountLeft {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \term E e;

        \assumes(seqPerm<E>(s1, s2) ==>)
        \find(seqCount<E>(s1, e))
        \add(seqCount<E>(s1, e) = seqCount<E>(s2, e) ==>)
        \heuristics(seqPermCountAntec)
    };

    \lemma
    seqPermCountRight {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \term E e;

        \assumes(seqPerm<E>(s1, s2) ==>)
        \find(seqCount<E>(s2, e))
        \add(seqCount<E>(s1, e) = seqCount<E>(s2, e) ==>)
        \heuristics(seqPermCountAntec)
    };

    \lemma
    seqCountOfSeqEmpty {
        \schemaVar \term E e;

        \find(seqCount<E>(seqEmpty<E>, e))
        \replacewith(0)
        \heuristics(seqCountSimp)
    };

    \lemma
    seqCountOfSeqSingleton {
        \schemaVar \term E x, e;

        \find(seqCount<E>(seqSingleton<E>(x), e))
        \replacewith(\if (x = e) \then (1) \else (0))
        \heuristics(seqCountSimp)
        \generate(\EQ(seqSingleton<E>(x)))
    };

    \lemma
    seqCountOfSeqConcat {
        \schemaVar \term Seq<E> s1, s2;
        \schemaVar \term E e;

        \find(seqCount<E>(seqConcat<E>(s1, s2), e))
        \replacewith(seqCount<E>(s1, e) + seqCount<E>(s2, e))
        \heuristics(seqCountSimp)
        \generate(\EQ(seqConcat<E>(s1, s2)))
    };

    \lemma
    seqCountOfSeqUpd {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int i;
        \schemaVar \term E x, e;

        \find(seqCount<E>(seqUpd<E>(s, i, x), e))
        \replacewith(seqCount<E>(s, e)
            + (\if (0 <= i & i < seqLen<E>(s))
                \then ((\if (x = e) \then (1) \else (0)) - (\if (seqGet<E>(s, i) = e) \then (1) \else (0)))
                \else (0)))
        \heuristics(seqCountSimp)
        \generate(\EQ(seqUpd<E>(s, i, x)))
    };

    \lemma
    seqCountOfSeqSwap {
        \schemaVar \term Seq<E> s;
        \schemaVar \term int i, j;
        \schemaVar \term E e;

        \find(seqCount<E>(seqSwap<E>(s, i, j), e))
        \replacewith(seqCount<E>(s, e))
        \heuristics(seqCountSimp)
        \generate(\EQ(seqSwap<E>(s, i, j)))
    };

    \lemma
    seqPermTransitivityLeft {
        \schemaVar \term Seq<E> x, y, m;

        \assumes(seqPerm<E>(x, m) ==>)
        \find(==> seqPerm<E>(x, y))
        \add(==> seqPerm<E>(m, y))
        \heuristics(seqPermTransitivity)
    };

    \lemma
    seqPermTransitivityLeftSym {
        \schemaVar \term Seq<E> x, y, m;

        \assumes(seqPerm<E>(m, x) ==>)
        \find(==> seqPerm<E>(x, y))
        \add(==> seqPerm<E>(m, y))
        \heuristics(seqPermTransitivity)
    };

    \lemma
    seqPermTransitivityRight {
        \schemaVar \term Seq<E> x, y, m;

        \assumes(seqPerm<E>(m, y) ==>)
        \find(==> seqPerm<E>(x, y))
        \add(==> seqPerm<E>(x, m))
        \heuristics(seqPermTransitivity)
    };

    \lemma
    seqPermTransitivityRightSym {
        \schemaVar \term Seq<E> x, y, m;

        \assumes(seqPerm<E>(y, m) ==>)
        \find(==> seqPerm<E>(x, y))
        \add(==> seqPerm<E>(x, m))
        \heuristics(seqPermTransitivity)
    };
}
